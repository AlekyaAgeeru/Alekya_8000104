<!DOCTYPE html>
<html>
<head>
    <title>Event Registration Form</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
        }

        .form-container {
            width: 400px;
            margin: 30px auto;
            padding: 20px;
            background-color: white;
            border-radius: 10px;
        }

        input, select, textarea {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            margin-bottom: 15px;
        }

        button {
            padding: 10px 15px;
            background-color: blue;
            color: white;
            border: none;
        }

        output {
            color: green;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="form-container">

        <h2>Event Registration Form</h2>

        <form onsubmit="showMessage(); return false;">

            <label>Name:</label>
            <input type="text"
                   placeholder="Enter your name"